[Unit]
Description=orbita voice server for ESPHome voice satellites
Documentation=https://github.com/saniaxxx/orbita
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=exec
User=orbita
Group=orbita
# OPENAI_API_KEY=... and other secrets, not in the world-readable config.
EnvironmentFile=-/etc/orbita/env
ExecStartPre=/opt/orbita/venv/bin/orbita -c /etc/orbita/config.yaml --check
ExecStart=/opt/orbita/venv/bin/orbita -c /etc/orbita/config.yaml
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
